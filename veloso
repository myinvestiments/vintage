    <!-- Scripts de Interatividade -->
    <script>
        function abrirModal(titulo, preco, descricao, imagem) {
            document.getElementById('modal-titulo').innerText = titulo;
            document.getElementById('modal-preco').innerText = preco;
            document.getElementById('modal-descricao').innerText = descricao;
            document.getElementById('modal-img').src = imagem;
            
            const mensagem = encodeURIComponent(`Olá! Tenho interesse no relógio *${titulo}* anunciado por *${preco}* no site da Veloso Vintage.`);
            document.getElementById('modal-whatsapp-btn').href = `https://wa.me/5500000000000?text=${mensagem}`;
            
            document.getElementById('modal-produto').classList.remove('hidden');
        }

        function fecharModal() {
            document.getElementById('modal-produto').classList.add('hidden');
        }

        window.onclick = function(event) {
            const modal = document.getElementById('modal-produto');
            if (event.target == modal) {
                fecharModal();
            }
        }

        function filtrarMarca(marca) {
            const cards = document.querySelectorAll('.produto-card');
            const botoes = document.querySelectorAll('.filter-btn');

            botoes.forEach(btn => {
                if(btn.innerText.toLowerCase() === marca.toLowerCase() || (marca === 'todos' && btn.innerText === 'Todos')) {
                    btn.classList.remove('bg-neutral-800', 'text-neutral-300');
                    btn.classList.add('bg-vintage-gold', 'text-vintage-dark');
                } else {
                    btn.classList.remove('bg-vintage-gold', 'text-vintage-dark');
                    btn.classList.add('bg-neutral-800', 'text-neutral-300');
                }
            });

            cards.forEach(card => {
                if(marca === 'todos' || card.getAttribute('data-marca') === marca) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        }
    </script>
